<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">
    <TextView android:id="@+id/tvEmailShow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تم إرسال الكود" android:textSize="16sp" android:layout_marginBottom="16dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="صفحة تحقق من الكود" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="كود التحقق">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCodeVerify" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="6"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutNewPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="كلمة المرور الجديدة" android:layout_marginTop="12dp" android:visibility="gone">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNewPassVerify" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutConfirmNewPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="إعادة كلمة المرور الجديدة" android:layout_marginTop="12dp" android:visibility="gone">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConfirmNewPassVerify" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Button android:id="@+id/btnVerify" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تأكيد الكود" android:layout_marginTop="24dp"/>
    <TextView android:id="@+id/tvResultVerify" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#D32F2F"/>
</LinearLayout>
